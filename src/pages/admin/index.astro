---
import Sidebar from "../../components/admin/Sidebar.astro";
import Navbar from "../../components/admin/Navbar.astro";
---

<style>
.admin {
  display: flex;
  min-height: 100vh;
}

.main {
  flex: 1;
  background: #f5f5f5;
}

.content {
  padding: 20px;
}

.cards {
  display: flex;
  gap: 20px;
  margin-top: 20px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 10px;
  width: 200px;
  box-shadow: 0 2px 8px rgba(0,0,0,.1);
}
</style>

<div class="admin">
  <Sidebar />

  <div class="main">
    <Navbar />

    <div class="content">
      <h1>Dashboard Admin</h1>

      <div class="cards">
        <div class="card">
          <h3>Artikel</h3>
          <p>20</p>
        </div>

        <div class="card">
          <h3>Carousel</h3>
          <p>5</p>
        </div>

        <div class="card">
          <h3>Konten</h3>
          <p>12</p>
        </div>
      </div>

    </div>

  </div>
</div>