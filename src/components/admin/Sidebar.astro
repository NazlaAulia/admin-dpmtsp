---
// Ambil URL halaman yang sedang dibuka saat ini
const pathname = Astro.url.pathname;
---

<style>
.sidebar {
    width: 260px;
    background: #1e3a8a;
    color: white;
    min-height: 100vh;
    padding: 20px 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.sidebar-top h2 {
    font-size: 20px;
    margin-bottom: 30px;
    font-weight: bold;
    letter-spacing: 0.5px;
    padding-left: 20px;
}

.sidebar ul {
    list-style: none;
    padding: 0;
    margin: 0;
}

.sidebar li {
    margin: 4px 0;
}

.sidebar a {
    color: #cbd5e1;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 0 8px 8px 0;
    transition: all 0.2s ease;
    font-size: 14px;
}

.sidebar a:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
}

.sidebar a.active {
    background: white;
    color: #1e3a8a;
    font-weight: 600;
}

.sidebar-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 15px;
}
</style>

<div class="sidebar">
    <div class="sidebar-top">
        <h2>DPM-PTSP</h2>
        <ul>
            <li><a href="/admin" class={pathname === "/admin" ? "active" : ""}>🏠 Dashboard</a></li>
            <li><a href="/admin/artikel" class={pathname.startsWith("/admin/artikel") ? "active" : ""}>📰 Artikel / Berita</a></li>
            <li><a href="/admin/kinerja" class={pathname.startsWith("/admin/kinerja") ? "active" : ""}>📈 Kinerja Investasi</a></li>
            <li><a href="/admin/layanan" class={pathname.startsWith("/admin/layanan") ? "active" : ""}>🏢 Tempat Layanan</a></li>
            <li><a href="/admin/konten" class={pathname.startsWith("/admin/konten") ? "active" : ""}>📄 Konten</a></li>
            <li><a href="/admin/inovasi" class={pathname.startsWith("/admin/inovasi") ? "active" : ""}>💡 Inovasi</a></li>
            <li><a href="/admin/carousel" class={pathname.startsWith("/admin/carousel") ? "active" : ""}>🖼 Carousel</a></li>
            <li><a href="/admin/pemberitahuan" class={pathname.startsWith("/admin/pemberitahuan") ? "active" : ""}>🔔 Pemberitahuan</a></li>
        </ul>
    </div>
    
    <div class="sidebar-bottom">
        <ul>
            <li><a href="/logout">🚪 Logout</a></li>
        </ul>
    </div>
</div>